# VS Code supports Linux distributions older than the development container.
# Compile node-pty on glibc 2.31 so the release does not inherit symbols from
# Debian testing merely because the Rust pipeline runs there.
FROM node:22-bullseye-slim@sha256:4f62fbb9636675c988f0ade6bae760e42301e4eab67284241d201aa0204bc2d7 AS build

ARG APT_SNAPSHOT=20260713T000000Z
RUN sed -i -E \
        -e "s|^deb http://deb.debian.org/debian bullseye main$|deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${APT_SNAPSHOT} bullseye main|" \
        -e "s|^deb http://deb.debian.org/debian-security bullseye-security main$|deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${APT_SNAPSHOT} bullseye-security main|" \
        -e "s|^deb http://deb.debian.org/debian bullseye-updates main$|deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${APT_SNAPSHOT} bullseye-updates main|" \
        /etc/apt/sources.list \
    && ! grep -q '^deb http://deb.debian.org' /etc/apt/sources.list \
    && apt-get update \
    && apt-get install --yes --no-install-recommends binutils g++ make python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY vscode/package.json vscode/package-lock.json ./
RUN npm_config_build_from_source=true npm ci
COPY vscode ./
RUN npm run package \
    && native_binding=$(find dist/node-pty -name pty.node -print -quit) \
    && test -n "$native_binding" \
    && max_glibc=$(objdump -T "$native_binding" \
        | grep -o 'GLIBC_[0-9.]*' \
        | sed 's/GLIBC_//' \
        | sort -V \
        | tail -1) \
    && test -n "$max_glibc" \
    && dpkg --compare-versions "$max_glibc" le 2.31

FROM scratch
COPY --from=build /build/dist/rumpelpod-vscode.vsix /
