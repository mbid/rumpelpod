[Unit]
Description=Rumpelpod development daemon
Requires=rumpelpod.socket

[Service]
Type=simple
EnvironmentFile=-%h/.config/rumpelpod/agent-environment
ExecStart=%h/.local/bin/rumpel daemon
Restart=on-failure
RestartSec=2
