[Unit]
Description=Rumpelpod browser VS Code
After=rumpelpod.socket
Requires=rumpelpod.socket

[Service]
Type=simple
WorkingDirectory=/workspaces/rumpelpod
ExecStart=/usr/local/bin/start-rumpelpod-vscode
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
