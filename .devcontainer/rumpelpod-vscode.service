[Unit]
Description=Rumpelpod browser VS Code
After=rumpelpod.socket
Requires=rumpelpod.socket
ConditionPathIsDirectory=/workspaces/anyhow-demo/.git

[Service]
Type=simple
WorkingDirectory=/workspaces/anyhow-demo
EnvironmentFile=-%h/.config/rumpelpod/agent-environment
ExecStart=%h/.local/lib/rumpelpod/start-vscode.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
